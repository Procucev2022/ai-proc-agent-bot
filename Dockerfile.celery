# ====================================================================
# OPTIMIZED CELERY WORKER DOCKERFILE - Azure Container Apps Production
# ====================================================================
FROM python:3.11-slim AS base

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Pre-download sentence transformer model so it's cached in the image
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

# Copy application code
COPY app/ ./app/
COPY templates/ ./templates/
COPY docker_entrypoint_celery.sh ./

# Make entrypoint executable
RUN chmod +x docker_entrypoint_celery.sh

# Create logs directory
RUN mkdir -p logs/celery_worker

CMD ["./docker_entrypoint_celery.sh"]
