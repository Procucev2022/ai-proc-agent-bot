[Unit]
Description=Celery Worker for Procurement Agent
After=network.target redis.service
Requires=redis.service

[Service]
Type=forking
User=www-data
Group=www-data
WorkingDirectory=/path/to/procucev_proc_agent
Environment="PATH=/path/to/procucev_proc_agent/venv/bin"
ExecStart=/path/to/procucev_proc_agent/venv/bin/celery -A app.celery_app worker \
    --loglevel=info \
    --logfile=/var/log/celery/worker.log \
    --pidfile=/var/run/celery/worker.pid \
    --detach
ExecStop=/path/to/procucev_proc_agent/venv/bin/celery -A app.celery_app control shutdown
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
