# AI Procurement Agent Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/procurement_db #Will change depending on client's choice
SQL_DEBUG=false

# OpenAI Configuration
AZURE_OPENAI_ENDPOINT = Azure OpenAI Endpoint
AZURE_OPENAI_API_KEY = Azure OpenAI Key


OPENAI_MODEL_DEFAULT=gpt-4.1-mini
OPENAI_MODEL_ADVANCED=gpt-4.1

# WhatsApp Business API Configuration
WHATSAPP_USERNAME=test_user
WHATSAPP_PASSWORD=test_password
WHATSAPP_FROM_NUMBER=918147745000
WHATSAPP_BASE_URL=https://media.sendmsg.in
WHATSAPP_TEMPLATE_BASE_URL=https://wsapi.sendmsg.in
WHATSAPP_WEBHOOK_URL=https://your-domain.com/webhook/whatsapp
WHATSAPP_VERIFY_TOKEN=your_verify_token
WHATSAPP_API_KEY=3fda329a-6944-11ec-a7c7-9606c7e32d76

# Redis Configuration (for session management)
REDIS_URL=redis://localhost:6379/0

# Application Configuration
APP_NAME=AI Procurement Agent
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=DEBUG
DEVELOPMENT_MODE=true
WHATSAPP_MOCK_MODE=true

# Security Configuration
SECRET_KEY=your_secret_key_for_jwt_and_encryption
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# External API Configuration (if needed)
PROCUREMENT_API_URL=https://your-procurement-system.com/api
PROCUREMENT_API_KEY=your_procurement_api_key

# GMT API Configuration
GMT_BASE_URL=https://devp2pindia-c5c7gfhhbsdxaycm.centralindia-01.azurewebsites.net
GMT_CLIENT_ID="procucev"
GMT_CLIENT_SECRET="procucev"
GMT_USERNAME="clientinitiator@procucev.com"
GMT_PASSWORD="Clientinitiator@123"

# Intent Service Configuration
INTENT_THRESHOLD_BUY_SOMETHING=75
INTENT_THRESHOLD_GENERAL_INQUIRY=60
INTENT_THRESHOLD_AMBIGUOUS=60

# Session and Timeout Configuration
SESSION_TIMEOUT_MINUTES=30
MAX_RETRY_ATTEMPTS=3
RATE_LIMIT_DEFAULT=100/hour
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_UPLOAD=5/minute