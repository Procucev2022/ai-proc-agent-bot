{
    "type": "function",
    "name": "extract_entities",
    "description": "Extract structured entities from user message for RFQ creation workflow. Can handle multiple products in a single message. Focus only on entity extraction - completeness checking is handled by the data model.",
    "parameters": {
        "type": "object",
        "properties": {
            "products": {
                "type": "array",
                "description": "Array of product entities extracted from the message",
                "items": {
                    "type": "object",
                    "properties": {
                        "projectDesc": {
                            "type": ["string", "null"],
                            "description": "Project description for the RFQ"
                        },
                        "description": {
                            "type": ["string", "null"],
                            "description": "Item description"
                        },
                        "quantity": {
                            "type": ["number", "null"],
                            "description": "Required quantity - numeric value"
                        },
                        "unitofMeasures": {
                            "type": ["string", "null"],
                            "description": "Unit of measurement: pcs, kg, meters, etc."
                        },
                        "deliveryDate": {
                            "type": ["string", "null"],
                            "description": "Required delivery date"
                        },
                        "division": {
                            "type": ["string", "null"],
                            "description": "Division: Admin & IT, CAPEX - Equipment & Machinery, Civil & Electrical Works, etc."
                        },
                        "category": {
                            "type": ["string", "null"],
                            "description": "Product category"
                        },
                        "brand": {
                            "type": ["string", "null"],
                            "description": "Preferred brand name"
                        },
                        "location": {
                            "type": ["string", "null"],
                            "description": "Delivery location (city, state, or full address)"
                        },
                        "remarks": {
                            "type": ["string", "null"],
                            "description": "Additional remarks or requirements"
                        }
                    },
                    "required": ["projectDesc", "description", "quantity", "unitofMeasures", "deliveryDate", "division", "category", "brand", "location", "remarks"],
                    "additionalProperties": false
                }
            },
            "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Confidence in the entity extraction accuracy"
            }
        },
        "required": ["products", "confidence"],
        "additionalProperties": false
    },
    "strict": true
}