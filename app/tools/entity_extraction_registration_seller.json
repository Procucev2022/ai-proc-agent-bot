{
    "type": "function",
    "name": "extract_seller_registration_entities",
    "description": "Extract seller registration information from user message with context awareness",
    "parameters": {
        "type": "object",
        "properties": {
            "entities": {
                "type": "object",
                "properties": {
                    "full_name": {
                        "type": ["string", "null"],
                        "description": "Full name of the seller"
                    },
                    "company_name": {
                        "type": ["string", "null"],
                        "description": "Company or organization name"
                    },
                    "email": {
                        "type": ["string", "null"],
                        "description": "Organization email address"
                    },
                    "location": {
                        "type": ["string", "null"],
                        "description": "Company location (city, state)"
                    },
                    "pincode": {
                        "type": ["string", "null"],
                        "description": "6-digit pincode"
                    },
                    "gstin": {
                        "type": ["string", "null"],
                        "description": "GSTIN number - must be exactly 15 characters" },
                    "products_services": {
                        "type": ["string", "null"],
                        "description": "Products or services offered"
                    }
                },
                "required": ["full_name", "company_name", "email", "location", "pincode", "gstin", "products_services"],
                "additionalProperties": false
            },
            "completeness": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Percentage of required fields collected"
            },
            "missing_fields": {
                "type": "array",
                "items": {"type": "string"},
                "description": "List of missing required fields"
            },
            "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Confidence in extracted entities (0-100)"
            }
        },
        "required": ["entities", "completeness", "missing_fields", "confidence"],
        "additionalProperties": false
    },
    "strict": true
}