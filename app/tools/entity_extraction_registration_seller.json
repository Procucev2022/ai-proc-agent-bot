{
    "type": "function",
    "name": "extract_seller_registration_entities",
    "description": "Extract seller registration information from user message with context awareness",
    "parameters": {
        "type": "object",
        "properties": {
            "entities": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": ["string", "null"],
                        "description": "Full name of the seller"
                    },
                    "companyName": {
                        "type": ["string", "null"],
                        "description": "Company or organization name"
                    },
                    "email": {
                        "type": ["string", "null"],
                        "description": "Business email address"
                    },
                    "address": {
                        "type": ["string", "null"],
                        "description": "Company location/address"
                    },
                    "zipCode": {
                        "type": ["string", "null"],
                        "description": "6-digit pincode"
                    },
                    "gstin": {
                        "type": ["string", "null"],
                        "description": "GSTIN number - must be exactly 15 characters"
                    },
                    "details": {
                        "type": ["string", "null"],
                        "description": "Products or services offered (mapped to 'details' in API)"
                    }
                },
                "required": ["name", "companyName", "email", "address", "zipCode", "gstin", "products_services"],
                "additionalProperties": false
            },
            "completeness": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Percentage of required fields collected"
            },
            "missing_fields": {
                "type": "array",
                "items": {"type": "string"},
                "description": "List of missing required fields"
            },
            "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Confidence in extracted entities (0-100)"
            }
        },
        "required": ["entities", "completeness", "missing_fields", "confidence"],
        "additionalProperties": false
    },
    "strict": true
}