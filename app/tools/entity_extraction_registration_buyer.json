{
    "type": "function",
    "name": "extract_buyer_registration_entities",
    "description": "Extract buyer registration information from user message with context awareness",
    "parameters": {
        "type": "object",
        "properties": {
            "entities": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": ["string", "null"],
                        "description": "Full name of the buyer"
                    },
                    "companyName": {
                        "type": ["string", "null"],
                        "description": "Company or organization name"
                    },
                    "email": {
                        "type": ["string", "null"],
                        "description": "Organization email address"
                    },
                    "zipCode": {
                        "type": ["string", "null"],
                        "description": "6-digit pincode"
                    }
                },
                "required": ["name", "companyName", "email", "zipCode"],
                "additionalProperties": false
            },
            "completeness": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Percentage of required fields collected"
            },
            "missing_fields": {
                "type": "array",
                "items": {"type": "string"},
                "description": "List of missing required fields"
            },
            "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Confidence in extracted entities (0-100)"
            }
        },
        "required": ["entities", "completeness", "missing_fields", "confidence"],
        "additionalProperties": false
    },
    "strict": true
}