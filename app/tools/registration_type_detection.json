{
  "type": "function",
  "name": "registration_type_detection",
  "description": "Analyze user message to detect registration type preference (buyer or seller)",
  "parameters": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "enum": ["buyer", "seller"],
        "description": "The detected registration type"
      },
      "confidence": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "description": "Confidence level of the detection (0.0 to 1.0)"
      },
      "reasoning": {
        "type": "string",
        "description": "Brief explanation of the decision"
      }
    },
    "required": ["type", "confidence", "reasoning"]
  }
}