{
    "type": "function",
    "name": "classify_intent",
    "description": "Classify user intent for procurement agent routing with confidence scoring, multi-intent analysis, and conversation context awareness",
    "parameters": {
        "type": "object",
        "properties": {
            "intent": {
                "type": "string",
                "enum": ["buy_something", "sell_something", "account_switch", "register_account", "general_inquiry", "modification_request", "confirmation_response", "rfq_status_check", "reference_request", "ambiguous", "contextual_reference", "session_inquiry", "workflow_rejection", "alternative_request"],
                "description": "The primary classified intent category based on user message analysis and conversation context"
            },
            "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Confidence score as percentage (0-100) for the primary classification"
            },
            "all_intent_scores": {
                "type": "object",
                "properties": {
                    "buy_something": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    },
                    "sell_something": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    },
                    "account_switch": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    },
                    "register_account": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    },
                    "general_inquiry": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    },
                    "modification_request": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    },
                    "confirmation_response": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    },
                    "rfq_status_check": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    },
                    "reference_request": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    },
                    "contextual_reference": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    },
                    "session_inquiry": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    },
                    "workflow_rejection": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    },
                    "alternative_request": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    }
                },
                "required": ["buy_something", "sell_something", "account_switch", "register_account", "general_inquiry", "modification_request", "confirmation_response", "rfq_status_check", "reference_request", "contextual_reference", "session_inquiry", "workflow_rejection", "alternative_request"],
                "additionalProperties": false,
                "description": "Confidence scores for all intent categories"
            },
            "context_analysis": {
                "type": "object",
                "properties": {
                    "references_existing_data": {
                        "type": "boolean",
                        "description": "Whether the message references previously mentioned entities or data"
                    },
                    "conversation_stage": {
                        "type": "string",
                        "enum": ["collecting", "confirming", "modifying", "referencing", "completed", "unknown"],
                        "description": "Current stage of the conversation based on context"
                    },
                    "modification_details": {
                        "type": "object",
                        "properties": {
                            "target_entity": {
                                "type": ["string", "null"],
                                "description": "What entity/field is being modified (e.g., 'chairs', 'delivery_date')"
                            },
                            "modification_type": {
                                "type": ["string", "null"],
                                "enum": ["quantity", "delivery_date", "location", "specifications", "division", "other", null],
                                "description": "Type of modification being requested"
                            }
                        },
                        "required": ["target_entity", "modification_type"],
                        "additionalProperties": false,
                        "description": "Details about modification if this is a modification_request"
                    },
                    "confirmation_details": {
                        "type": "object",
                        "properties": {
                            "response_type": {
                                "type": ["string", "null"],
                                "enum": ["accept", "decline", "conditional", null],
                                "description": "Type of confirmation response"
                            },
                            "has_conditions": {
                                "type": "boolean",
                                "description": "Whether confirmation includes conditions or modifications"
                            }
                        },
                        "required": ["response_type", "has_conditions"],
                        "additionalProperties": false,
                        "description": "Details about confirmation if this is a confirmation_response"
                    },
                    "reference_details": {
                        "type": "object",
                        "properties": {
                            "reference_type": {
                                "type": ["string", "null"],
                                "enum": ["delivery_location", "division", "product_specs", "quantity", "general", null],
                                "description": "Type of entity being referenced from previous data"
                            },
                            "has_history": {
                                "type": "boolean",
                                "description": "Whether user has relevant historical data available"
                            }
                        },
                        "required": ["reference_type", "has_history"],
                        "additionalProperties": false,
                        "description": "Details about reference if this is a reference_request"
                    },
                    "account_switch_details": {
                        "type": "object",
                        "properties": {
                            "target_role": {
                                "type": ["string", "null"],
                                "enum": ["buyer", "seller", "same", null],
                                "description": "Target role user wants to switch to ('same' means different account of same role)"
                            },
                            "switch_type": {
                                "type": ["string", "null"],
                                "enum": ["cross_role", "same_role", "unclear", null],
                                "description": "Type of account switch requested"
                            }
                        },
                        "required": ["target_role", "switch_type"],
                        "additionalProperties": false,
                        "description": "Details about account switch if this is an account_switch intent"
                    },
                    "registration_details": {
                        "type": "object",
                        "properties": {
                            "registration_type": {
                                "type": ["string", "null"],
                                "enum": ["buyer", "seller", "unclear", null],
                                "description": "Type of account user wants to register"
                            },
                            "is_additional_account": {
                                "type": "boolean",
                                "description": "Whether this is an additional account registration (user already authenticated)"
                            }
                        },
                        "required": ["registration_type", "is_additional_account"],
                        "additionalProperties": false,
                        "description": "Details about registration if this is a register_account intent"
                    }
                },
                "required": ["references_existing_data", "conversation_stage", "modification_details", "confirmation_details", "reference_details", "account_switch_details", "registration_details"],
                "additionalProperties": false,
                "description": "Analysis of conversation context and how it affects intent classification"
            },
            "reasoning": {
                "type": "string",
                "description": "Brief explanation of why this intent was chosen including context analysis"
            },
            "suggested_clarification": {
                "type": ["string", "null"],
                "description": "If confidence is low or intents are similar, suggest what clarification question to ask"
            }
        },
        "required": ["intent", "confidence", "all_intent_scores", "context_analysis", "reasoning", "suggested_clarification"],
        "additionalProperties": false
    },
    "strict": true
}