# ====================================================================
# SHARED DEPENDENCY IMAGE - BUILD ONCE, USE EVERYWHERE
# ====================================================================
# Everything in this file is expensive and changes rarely: the apt packages
# and requirements.txt. Dockerfile.app starts FROM the image this file
# produces, so these layers are built once and reused by the web app, the
# Celery worker and Celery beat.
#
# CI keys the published tag on the hash of this file plus requirements.txt
# (see .github/workflows/deploy-*.yml), so a deploy that touches neither one
# reuses the image instead of reinstalling every wheel. ACR quick tasks run
# on a fresh agent with no layer cache, which is why the reuse has to be
# explicit rather than left to Docker.
#
#   local/VM:  docker build -f Dockerfile.base -t procucev-base:local .
#   CI:        az acr build --image aiproc-base:py311-<hash> -f Dockerfile.base .
# ====================================================================
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy requirements
COPY requirements.txt .

RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Verify critical packages
RUN pip list | grep -E "(gunicorn|celery)"
